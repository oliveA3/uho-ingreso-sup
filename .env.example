# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores.
# El archivo ".env" NO se sube a Git. Django y docker compose lo leen automáticamente.

# --- Django ---
# En producción: DJANGO_DEBUG=false y una DJANGO_SECRET_KEY propia. El arranque
# aborta si declaras hosts públicos con DEBUG activo, o si desactivas DEBUG sin
# definir la clave.
DJANGO_DEBUG=true
# Solo para desarrollo local. En producción reemplázala por una clave generada.
DJANGO_SECRET_KEY=django-insecure-change-this-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Orígenes públicos del frontend, separados por comas: de aquí salen
# CORS_ALLOWED_ORIGINS y CSRF_TRUSTED_ORIGINS. Obligatorio con DEBUG=false.
# Si se omite, se usa FRONTEND_URL y, en desarrollo, los puertos de Vite.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Pon "true" solo si el frontend y la API están en dominios distintos: las
# cookies de sesión pasan a SameSite=None (y Secure cuando DEBUG=false), que es
# lo que exige el navegador para enviarlas entre sitios.
CROSS_SITE_COOKIES=false

# --- Base de datos: PostgreSQL 14+ ---
# Sin DB_ENGINE (o con "sqlite") se usa SQLite, solo válido para pruebas rápidas.
DB_ENGINE=postgresql
DB_NAME=ingresosup
DB_USER=ingresosup
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# --- Redis 7+ (caché, limitación de peticiones y cola de tareas) ---
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Correo (console | mailtrap | sendgrid | smtp) ---
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=no-reply@ingresosup.local

# --- Semilla demo (opcional; no se usa en producción) ---
# INGRESOSUP_SEED_PASSWORD=usa-una-clave-unica-si-habilitas-las-cuentas-demo
