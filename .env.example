# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores.
# El archivo ".env" NO se sube a Git. Django y docker compose lo leen automáticamente.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos: PostgreSQL 14+ ---
# Sin DB_ENGINE (o con "sqlite") se usa SQLite, solo válido para pruebas rápidas.
DB_ENGINE=postgresql
DB_NAME=ingresosup
DB_USER=ingresosup
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# --- Redis 7+ (caché, limitación de peticiones y cola de tareas) ---
REDIS_URL=redis://localhost:6379

# --- Correo (console | mailtrap | sendgrid | smtp) ---
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=no-reply@ingresosup.local
